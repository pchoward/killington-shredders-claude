---
// MTB trail difficulty, using the symbols riders already know from trail maps.
import { trailRatings } from '../lib/taxonomy';

interface Props {
  rating: 'green' | 'blue' | 'black' | 'double-black' | 'pro';
  /** Full label ("Intermediate") instead of the short one ("Int."). */
  long?: boolean;
}
const { rating, long = false } = Astro.props;
const info = trailRatings[rating];
---

<span class="rating" title={info.title}>
  {rating === 'green' && <span class="sym green" aria-hidden="true"></span>}
  {rating === 'blue' && <span class="sym blue" aria-hidden="true"></span>}
  {rating === 'black' && <span class="sym diamond" aria-hidden="true"></span>}
  {
    rating === 'double-black' && (
      <span class="dbl" aria-hidden="true">
        <span class="sym diamond small"></span>
        <span class="sym diamond small"></span>
      </span>
    )
  }
  {rating === 'pro' && <span class="sym pro" aria-hidden="true">PRO</span>}
  {
    rating === 'pro' ? (
      <span class="sr-only">{info.label}</span>
    ) : (
      <span class="mono label">
        <span aria-hidden={long ? undefined : 'true'}>{long ? info.label : info.short}</span>
        {!long && <span class="sr-only">{info.label}</span>}
      </span>
    )
  }
</span>

<style>
  .rating {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 24px;
  }
  .sym {
    display: inline-block;
    flex-shrink: 0;
  }
  .green {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #2fa84f;
  }
  .blue {
    width: 16px;
    height: 16px;
    background: #2e6fd8;
  }
  .diamond {
    width: 14px;
    height: 14px;
    background: #f2f4f6;
    transform: rotate(45deg);
    margin: 2px;
  }
  .diamond.small {
    width: 11px;
    height: 11px;
  }
  .dbl {
    display: inline-flex;
    gap: 3px;
  }
  .pro {
    padding: 4px 8px;
    border-radius: 999px;
    background: var(--orange);
    color: var(--orange-ink);
    font: 400 0.8rem/1 var(--font-display);
    letter-spacing: 0.06em;
    box-shadow: inset 0 0 0 2px var(--orange), inset 0 0 0 3.5px var(--orange-ink);
  }
  .label {
    color: var(--muted);
    font-size: 0.68rem;
  }
</style>
