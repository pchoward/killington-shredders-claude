---
// Events styled like a lift ticket: date stub + perforation + details.
import type { CollectionEntry } from 'astro:content';
import DemoBadge from './DemoBadge.astro';

interface Props {
  event: CollectionEntry<'events'>;
  past?: boolean;
}
const { event, past = false } = Astro.props;
const d = event.data;
const tz = 'America/New_York';
const month = d.start.toLocaleString('en-US', { month: 'short', timeZone: tz });
const day = d.start.toLocaleString('en-US', { day: 'numeric', timeZone: tz });
const weekday = d.start.toLocaleString('en-US', { weekday: 'short', timeZone: tz });
const time = d.allDay
  ? 'All day'
  : d.start.toLocaleString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: tz }) +
    (d.end ? `–${d.end.toLocaleString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: tz })}` : '');
const kinds: Record<string, string> = {
  session: 'Session',
  meetup: 'Meetup',
  'film-night': 'Film night',
  contest: 'Contest',
  'clean-up': 'Community day',
  other: 'Event',
};
---

<article class:list={['ticket', { past }]}>
  <div class="stub">
    <span class="mono wd">{weekday}</span>
    <span class="day">{day}</span>
    <span class="mono mo">{month}</span>
  </div>
  <div class="info">
    <div class="top">
      <span class="mono kind">{kinds[d.kind]}</span>
      {d.demo && <DemoBadge />}
      {past && <span class="chip">Past</span>}
    </div>
    <h3>{d.title}</h3>
    <p class="mono where">{time} · {d.location}</p>
    <div class="desc"><slot /></div>
    <p class="mono org">
      Organised by {d.organiser}
      {
        d.link && (
          <>
            {' · '}
            <a href={d.link} target="_blank" rel="noopener">Details ↗</a>
          </>
        )
      }
    </p>
  </div>
</article>

<style>
  .ticket {
    display: grid;
    grid-template-columns: 96px 1fr;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    position: relative;
  }
  .past .stub {
    background: var(--bg-3);
    color: var(--muted);
  }
  .past h3 {
    color: var(--muted);
  }
  .stub {
    background: var(--orange);
    color: var(--orange-ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 16px 8px;
    position: relative;
    border-right: 3px dashed var(--bg-2);
  }
  .day {
    font-family: var(--font-display);
    font-size: 2.8rem;
    line-height: 1;
  }
  .wd,
  .mo {
    font-weight: 700;
  }
  .info {
    padding: 18px 20px;
    min-width: 0;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 8px;
  }
  .kind {
    color: var(--ice);
  }
  h3 {
    margin-bottom: 8px;
  }
  .where {
    color: var(--muted);
    font-size: 0.72rem;
    margin-bottom: 8px;
  }
  .desc :global(p) {
    font-size: 0.95rem;
    margin-bottom: 8px;
  }
  .org {
    color: var(--muted);
    font-size: 0.66rem;
    margin: 0;
  }
  .org a {
    color: var(--orange);
  }
</style>
