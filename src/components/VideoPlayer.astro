---
// Click-to-load player. Nothing from YouTube/Vimeo/Instagram/TikTok loads
// (no cookies, no trackers, no heavy JS) until the viewer presses play.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Poster from './Poster.astro';
import { parseVideoUrl, isVertical } from '../lib/embed';

interface Props {
  url?: string;
  title: string;
  poster?: ImageMetadata;
  posterAlt?: string;
  demo?: boolean;
}
const { url, title, poster, posterAlt = '', demo = false } = Astro.props;
const embed = parseVideoUrl(url);
const vertical = isVertical(url) || embed?.provider === 'instagram';
const ratio = embed?.provider === 'instagram' ? '9 / 15' : vertical ? '9 / 16' : '16 / 9';
const remote = embed?.provider === 'youtube' ? embed.thumb : undefined;
const providerName = embed && embed.provider !== 'file' ? { youtube: 'YouTube', vimeo: 'Vimeo', instagram: 'Instagram', tiktok: 'TikTok' }[embed.provider] : undefined;
const videoPoster = embed?.provider === 'file' && poster ? (await getImage({ src: poster, width: 1600 })).src : undefined;
---

<div class:list={['player', { vertical }]}>
  {
    embed?.provider === 'file' ? (
      <video controls preload="none" playsinline poster={videoPoster} style={`aspect-ratio:${ratio}`}>
        <source src={embed.src} />
        <a href={embed.src}>Download the video</a>
      </video>
    ) : embed ? (
      <div class="facade" data-src={embed.src} data-title={title} style={`aspect-ratio:${ratio}`}>
        <Poster src={poster} remote={remote} alt={posterAlt} ratio={ratio} eager sizes="(max-width: 1000px) 100vw, 1000px" />
        <button class="play" type="button">
          <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
          <span class="sr-only">Play “{title}”</span>
        </button>
        <span class="consent mono">Plays from {providerName} · loads on click</span>
      </div>
    ) : (
      <div class="facade is-demo" style={`aspect-ratio:${ratio}`}>
        <Poster src={poster} alt={posterAlt} ratio={ratio} eager sizes="(max-width: 1000px) 100vw, 1000px" />
        <div class="demo-note">
          <strong class="mono">{demo ? 'Demo placeholder' : 'Video coming soon'}</strong>
          <span>{demo ? 'No real footage is attached to this sample entry.' : 'This clip hasn’t been linked yet.'}</span>
        </div>
      </div>
    )
  }
  {
    embed && embed.provider !== 'file' && (
      <a class="ext mono" href={embed.watch} target="_blank" rel="noopener">
        Watch on {providerName} ↗
      </a>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('.facade[data-src]').forEach((el) => {
    const btn = el.querySelector('button');
    btn?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = el.dataset.src!;
      iframe.title = el.dataset.title ?? 'Video';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
      iframe.allowFullscreen = true;
      iframe.loading = 'eager';
      el.replaceChildren(iframe);
      el.classList.add('loaded');
      iframe.focus();
    });
  });
</script>

<style>
  .player {
    width: 100%;
  }
  .player.vertical {
    max-width: 440px;
    margin-inline: auto;
  }
  .facade,
  video {
    position: relative;
    width: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
    border: 1px solid var(--line);
  }
  .facade :global(.poster) {
    position: absolute;
    inset: 0;
  }
  .facade :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    border: 0;
    background: var(--orange);
    color: var(--orange-ink);
    display: grid;
    place-items: center;
    padding-left: 6px;
    cursor: pointer;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    transition: transform 0.2s ease;
  }
  .play:hover {
    transform: scale(1.08);
  }
  .consent {
    position: absolute;
    left: 14px;
    bottom: 14px;
    font-size: 0.66rem;
    background: rgba(10, 13, 18, 0.8);
    padding: 4px 8px;
    border-radius: 4px;
  }
  .demo-note {
    position: absolute;
    inset: auto 16px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: rgba(10, 13, 18, 0.88);
    border: 1.5px dashed var(--orange);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    font-size: 0.95rem;
  }
  .demo-note strong {
    color: var(--orange);
  }
  .ext {
    display: inline-block;
    margin-top: 10px;
    color: var(--muted);
    text-decoration: none;
  }
  .ext:hover {
    color: var(--orange);
  }
</style>
