---
// Image for a card or player. Uses Astro's optimised <Image> for local files,
// falls back to a remote thumbnail (e.g. YouTube) or a branded gradient.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  remote?: string;
  alt: string;
  ratio?: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
}
const { src, remote, alt, ratio = '16 / 9', sizes = '(max-width: 700px) 100vw, 420px', eager = false } = Astro.props;
---

<div class="poster" style={`aspect-ratio:${ratio}`}>
  {
    src ? (
      <Image src={src} alt={alt} sizes={sizes} layout="full-width" loading={eager ? 'eager' : 'lazy'} />
    ) : remote ? (
      <img src={remote} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <div class="fallback" role="img" aria-label={alt}>
        <span>KS</span>
      </div>
    )
  }
  <slot />
</div>

<style>
  .poster {
    position: relative;
    overflow: hidden;
    background: var(--bg-3);
    border-radius: inherit;
  }
  .poster :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 70% 20%, rgba(255, 90, 31, 0.35), transparent 60%),
      linear-gradient(160deg, #18202b, #0a0d12);
  }
  .fallback span {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--orange);
    opacity: 0.6;
  }
</style>
