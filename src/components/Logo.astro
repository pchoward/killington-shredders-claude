---
// Mark: the orange oval used on terrain-park signage, with "KS" set in it.
interface Props {
  size?: number;
  withWordmark?: boolean;
}
const { size = 40, withWordmark = true } = Astro.props;
---

<span class="logo">
  <svg width={size * 1.6} height={size} viewBox="0 0 64 40" aria-hidden="true">
    <rect x="1" y="1" width="62" height="38" rx="19" fill="#ff5a1f" />
    <rect x="4.5" y="4.5" width="55" height="31" rx="15.5" fill="none" stroke="#1a0a03" stroke-width="1.5" />
    <text x="32" y="29" text-anchor="middle" font-family="Anton, Impact, sans-serif" font-size="22" fill="#1a0a03" letter-spacing="1">KS</text>
  </svg>
  {
    withWordmark && (
      <span class="wordmark">
        <span>Killington</span>
        <span>Shredders</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .wordmark {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    text-transform: uppercase;
    line-height: 0.92;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
  }
  .wordmark span:last-child {
    color: var(--orange);
  }
</style>
