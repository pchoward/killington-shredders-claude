---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DemoBadge from '../../components/DemoBadge.astro';
import StoryCard from '../../components/StoryCard.astro';
import Prose from '../../components/Prose.astro';
import { getStories } from '../../lib/content';
import { formatDate, href } from '../../lib/util';

export async function getStaticPaths() {
  const stories = await getStories();
  return stories.map((story) => ({ params: { slug: story.id }, props: { story, all: stories } }));
}

const { story, all } = Astro.props;
const d = story.data;
const { Content } = await render(story);
const more = all.filter((s) => s.id !== story.id).slice(0, 3);
const og = d.cover ? (await getImage({ src: d.cover, width: 1200, format: 'png' })).src : undefined;
---

<Base title={d.title} description={d.excerpt} image={og} type="article">
  <article>
    <header class="story-head wrap">
      <nav class="crumbs mono" aria-label="Breadcrumb"><a href={href('/stories/')}>← All stories</a></nav>
      <div class="tags">{d.demo && <DemoBadge />}{d.tags.map((t) => <span class="chip">#{t}</span>)}</div>
      <h1>{d.title}</h1>
      <p class="excerpt">{d.excerpt}</p>
      <p class="byline mono">By {d.author} · <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></p>
    </header>
    {
      d.cover && (
        <div class="wrap cover">
          <Image src={d.cover} alt={d.coverAlt ?? ''} layout="full-width" loading="eager" />
        </div>
      )
    }
    <div class="wrap body">
      <Prose><Content /></Prose>
    </div>
  </article>

  {
    more.length > 0 && (
      <section class="section wrap">
        <h2 class="more-h">Keep reading</h2>
        <div class="grid grid--3">
          {more.map((s) => (
            <StoryCard story={s} />
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .story-head {
    padding-top: 28px;
    max-width: 960px;
  }
  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 16px;
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 5rem);
  }
  .excerpt {
    font-size: 1.3rem;
    color: var(--muted);
    margin-top: 20px;
    max-width: 60ch;
  }
  .byline {
    color: var(--muted);
  }
  .cover {
    margin-block: 32px 8px;
  }
  .cover :global(img) {
    border-radius: var(--radius);
    width: 100%;
    max-height: 70vh;
    object-fit: cover;
  }
  .body {
    max-width: 960px;
    padding-top: 24px;
  }
  .more-h {
    margin-bottom: 24px;
  }
</style>
