---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import DemoBadge from '../../components/DemoBadge.astro';
import { getCrew } from '../../lib/content';
import { href, labels } from '../../lib/util';

const crew = await getCrew();
---

<Base title="Crew" description="Local riders featured on Killington Shredders.">
  <PageHead
    kicker="Crew"
    title="The crew"
    intro="Local riders from the crew: skiers and snowboarders first, and plenty who ride bikes all summer. Every profile is published with the rider's OK."
  />
  <section class="section wrap">
    {
      crew.length ? (
        <ul class="grid grid--4 crew">
          {crew.map((r) => (
            <li>
              <a href={href(`/crew/${r.id}/`)} class="card">
                <div class="pic">
                  {r.data.portrait ? (
                    <Image src={r.data.portrait} alt={r.data.portraitAlt ?? ''} width={600} />
                  ) : (
                    <span class="initial">{r.data.name[0]}</span>
                  )}
                  {r.data.demo && <DemoBadge floating />}
                </div>
                <div class="body">
                  <h2>{r.data.name}</h2>
                  <p class="mono muted">
                    {r.data.disciplines.map((d) => labels[d]).join(' / ')}
                    {r.data.favoriteFeature && ` · ${r.data.favoriteFeature}`}
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">
          <strong>Crew profiles coming soon</strong>We only add riders who've said yes.
        </p>
      )
    }
  </section>
</Base>

<style>
  .crew {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-2);
    border: 1px solid var(--line);
    transition: border-color 0.2s ease;
  }
  .card:hover {
    border-color: var(--orange);
    color: inherit;
  }
  .pic {
    position: relative;
    aspect-ratio: 1;
    background: var(--bg-3);
    overflow: hidden;
  }
  .pic :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.4) contrast(1.05);
    transition: filter 0.3s ease;
  }
  .card:hover .pic :global(img) {
    filter: none;
  }
  .initial {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-display);
    font-size: 5rem;
    color: var(--orange);
  }
  .body {
    padding: 16px 18px 20px;
  }
  h2 {
    font-size: 1.6rem;
    margin-bottom: 6px;
  }
  .body p {
    margin: 0;
  }
</style>
