---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import VideoCard from '../../components/VideoCard.astro';
import Filters from '../../components/Filters.astro';
import { getVideos } from '../../lib/content';
import { disciplineChoices, featureChoices, seasonalOrder } from '../../lib/taxonomy';

const videos = seasonalOrder(await getVideos());
const disciplines = disciplineChoices(videos.map((v) => v.data.disciplines));
const features = featureChoices(videos.map((v) => v.data.features));
---

<Base title="Videos" description="Rider edits and session clips from Killington: park laps all winter, bike laps all summer.">
  <PageHead
    kicker="Videos"
    title="The edits"
    intro="Park laps all winter, bike laps all summer, and the odd skatepark session in between. Filter by how you ride and what you like to hit."
  />
  <section class="section wrap">
    {
      videos.length ? (
        <>
          <h2 class="sr-only">All videos</h2>
          <Filters target="#video-grid" disciplines={disciplines} features={features} />
          <div id="video-grid" class="grid grid--3">
            {videos.map((v) => (
              <VideoCard video={v} />
            ))}
          </div>
        </>
      ) : (
        <p class="empty">
          <strong>No edits yet</strong>The first clips are being cut. Check back soon.
        </p>
      )
    }
  </section>
</Base>
