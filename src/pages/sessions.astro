---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import EventTicket from '../components/EventTicket.astro';
import site from '../data/site.json';
import { getEvents } from '../lib/content';
import { instagramUrl } from '../lib/util';

const events = await getEvents();
const now = new Date();
const withContent = await Promise.all(events.map(async (e) => ({ e, Content: (await render(e)).Content })));
const upcoming = withContent.filter(({ e }) => (e.data.end ?? e.data.start) >= now);
const past = withContent.filter(({ e }) => (e.data.end ?? e.data.start) < now).reverse().slice(0, 6);
const insta = instagramUrl(site.social.instagram);
const group = site.social.facebookGroup;
---

<Base title="Sessions" description="Meetups, film nights, group rides and dig days for the Killington Shredders crew.">
  <PageHead
    kicker="Sessions"
    title="Sessions & meetups"
    intro="Park meetups and film nights in winter, group rides and dig days in summer. Plans change with the weather, so final details always go out in the Facebook group first."
  >
    {
      (group || insta) && (
        <p class="head-ctas">
          {group && <a href={group} class="btn btn--hot" target="_blank" rel="noopener">Join the group for updates ↗</a>}
          {insta && <a href={insta} class="btn" target="_blank" rel="noopener">Instagram ↗</a>}
        </p>
      )
    }
  </PageHead>

  <section class="section wrap">
    <h2 class="h">Upcoming</h2>
    {
      upcoming.length ? (
        <div class="list">
          {upcoming.map(({ e, Content }) => (
            <EventTicket event={e}>
              <Content />
            </EventTicket>
          ))}
        </div>
      ) : (
        <p class="empty">
          <strong>Nothing scheduled</strong>Next session will be announced soon.
        </p>
      )
    }

    {
      past.length > 0 && (
        <>
          <h2 class="h past-h">Past sessions</h2>
          <div class="list">
            {past.map(({ e, Content }) => (
              <EventTicket event={e} past>
                <Content />
              </EventTicket>
            ))}
          </div>
        </>
      )
    }

    <aside class="note">
      <strong>Good to know.</strong> Community sessions are informal get-togethers organised by riders. They aren't
      run, sponsored or supervised by Killington Resort, any ski area or bike park, or any trail organisation. You'll
      need your own ticket or pass, everyone rides at their own risk, and we follow posted rules and trail closures.
      Dig days happen only with the trail owner's OK.
    </aside>
  </section>
</Base>

<style>
  .h {
    margin-bottom: 20px;
  }
  .head-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .past-h {
    margin-top: 56px;
  }
  .list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 460px), 1fr));
    gap: 16px;
  }
  .note {
    margin-top: 48px;
    padding: 20px 24px;
    border-left: 4px solid var(--ice);
    background: var(--bg-2);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--muted);
    max-width: 80ch;
  }
  .note strong {
    color: var(--text);
  }
</style>
