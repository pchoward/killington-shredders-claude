---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Snowfall from '../components/Snowfall.astro';
import SectionHead from '../components/SectionHead.astro';
import VideoCard from '../components/VideoCard.astro';
import StoryCard from '../components/StoryCard.astro';
import PhotoTile from '../components/PhotoTile.astro';
import EventTicket from '../components/EventTicket.astro';
import Lightbox from '../components/Lightbox.astro';
import heroSnow from '../assets/brand/hero-snow.jpg';
import heroSummer from '../assets/brand/hero-summer.jpg';
import site from '../data/site.json';
import glossary from '../data/glossary.json';
import { getVideos, getPhotos, getStories, getEvents, featuredFirst } from '../lib/content';
import { href, instagramUrl, labels } from '../lib/util';
import { currentSeason, seasons, primaryFamily, disciplineChoices } from '../lib/taxonomy';

const now = new Date();
const season = currentSeason(now);
const seasonInfo = seasons[season];
const isBikeSeason = season === 'bike';

// Snow is the identity: the lead edit is always a snow clip when one exists.
const videos = featuredFirst(await getVideos());
const fam = (v: { data: { disciplines: string[] } }) => primaryFamily(v.data.disciplines);
const snowVideos = videos.filter((v) => fam(v) === 'snow');
const bikeVideos = videos.filter((v) => fam(v) === 'bike');
const crossVideos = videos.filter((v) => fam(v) === 'cross');
const leadVideo = snowVideos[0] ?? videos[0];
// Side slots: snow first; outside snow season one slot previews the latest bike edit.
const sideVideos = [
  ...snowVideos.filter((v) => v !== leadVideo).slice(0, season === 'snow' ? 2 : 1),
  ...(season === 'snow' ? [] : bikeVideos.slice(0, 1)),
];
if (sideVideos.length < 2) sideVideos.push(...videos.filter((v) => v !== leadVideo && !sideVideos.includes(v)).slice(0, 2 - sideVideos.length));

// "Summer laps": hidden in snow season, third in stick/mud season, second in bike season.
const summerVideos = season === 'snow' ? [] : bikeVideos.filter((v) => !sideVideos.includes(v)).slice(0, isBikeSeason ? 4 : 3);
const allPhotos = await getPhotos();
const photos = (isBikeSeason ? allPhotos : [...allPhotos].sort((a, b) => Number(primaryFamily(a.data.disciplines) !== 'snow') - Number(primaryFamily(b.data.disciplines) !== 'snow'))).slice(0, 4);
const stories = featuredFirst(await getStories()).slice(0, 3);
const upcoming = (await getEvents()).filter((e) => (e.data.end ?? e.data.start) >= now).slice(0, 3);
const rendered = await Promise.all(upcoming.map(async (e) => ({ e, Content: (await render(e)).Content })));
const tabs = disciplineChoices(videos.map((v) => v.data.disciplines));

// Word of the day: snow terms in winter, anything goes in bike season.
const pool = isBikeSeason ? glossary : glossary.filter((g) => !['Bike', 'Skate & BMX'].includes(g.category));
const word = pool[Math.floor(now.valueOf() / 86_400_000) % pool.length];

const group = site.social.facebookGroup;
const insta = instagramUrl(site.social.instagram);
// Roughly 75 / 20 / 5, like everything else.
const ticker = ['Park laps', 'Rider edits', 'Rail gardens', 'Night sessions', 'Spring slush', 'Photo drops', 'Film nights', 'Local crews', 'Berm laps', 'Dig days', 'Mini ramp'];

let n = 0;
const idx = () => String(++n).padStart(2, '0');
---

<Base>
  <section class:list={['hero', `season-${season}`]}>
    <Image src={isBikeSeason ? heroSummer : heroSnow} alt="" class="hero-bg" layout="full-width" loading="eager" fetchpriority="high" />
    <div class="hero-shade"></div>
    {!isBikeSeason && <Snowfall />}
    <div class="wrap hero-inner">
      <p class="mono eyebrow">Freestyle ski &amp; snowboard crew · Killington, Vermont</p>
      <h1>
        <span>Ride it.</span>
        <span>Film it.</span>
        <span class="hot"><span>Share it.</span></span>
      </h1>
      <p class="lede">
        Park laps, edits and the people behind them. All winter on snow, all summer on bikes, and every ability level
        welcome.
      </p>
      <div class="ctas">
        {
          group ? (
            <>
              <a href={group} class="btn btn--hot" target="_blank" rel="noopener">Join the Facebook group</a>
              <a href={href('/videos/')} class="btn btn--ink">Watch the edits</a>
            </>
          ) : (
            <>
              <a href={href('/videos/')} class="btn btn--hot">Watch the edits</a>
              <a href={href('/share/')} class="btn btn--ink">Share a clip</a>
            </>
          )
        }
      </div>
      <p class="season-chip">
        <span class:list={['pill mono', `pill--${season}`]}>{seasonInfo.chip}</span>
        <span>{seasonInfo.line}</span>
      </p>
    </div>
    <div class="ticker" aria-hidden="true">
      <div class="track">
        {[...ticker, ...ticker].map((t) => <span>{t}<i>●</i></span>)}
      </div>
    </div>
  </section>

  {
    tabs.length > 1 && (
      <nav class="wrap tabs" aria-label="Browse videos by discipline">
        <a href={href('/videos/')} class="on">All</a>
        {tabs.map((t) => (
          <a href={href(`/videos/?d=${t}`)} class={`tab-${t}`}>{labels[t]}</a>
        ))}
      </nav>
    )
  }

  <section class="section wrap first" aria-label="Latest edits">
    <SectionHead index={idx()} title="Latest edits" link={{ label: 'All videos', path: '/videos/' }} />
    {
      leadVideo ? (
        <div class="vid-grid">
          <VideoCard video={leadVideo} large />
          <div class="vid-side">
            {sideVideos.map((v) => (
              <VideoCard video={v} />
            ))}
          </div>
        </div>
      ) : (
        <p class="empty">
          <strong>First edit dropping soon</strong>
          The first clips are being cut. Follow along in the group.
        </p>
      )
    }
  </section>

  {
    isBikeSeason && summerVideos.length > 0 && (
      <section class="section summer" aria-label="Summer laps">
        <div class="wrap">
          <SectionHead index={idx()} title="Summer laps" link={{ label: 'All bike edits', path: '/videos/?d=mtb' }} />
          <p class="band-intro">When the snow melts, the crew rides bikes. Jump lines, berms and bike park laps.</p>
          <div class="grid grid--4">
            {summerVideos.map((v) => (
              <VideoCard video={v} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    photos.length > 0 && (
      <section class="section photo-band" aria-label="Photos">
        <div class="wrap">
          <SectionHead index={idx()} title="Photo wall" link={{ label: 'All photos', path: '/photos/' }} />
          <div class="strip">
            {photos.map((p, i) => (
              <PhotoTile photo={p} index={i} />
            ))}
          </div>
        </div>
        <Lightbox />
      </section>
    )
  }

  {
    !isBikeSeason && summerVideos.length > 0 && (
      <section class="section summer" aria-label="Summer laps">
        <div class="wrap">
          <SectionHead index={idx()} title="Summer laps" link={{ label: 'All bike edits', path: '/videos/?d=mtb' }} />
          <p class="band-intro">When the snow melts, the crew rides bikes. The best of last summer while we wait.</p>
          <div class="grid grid--3">
            {summerVideos.map((v) => (
              <VideoCard video={v} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section wrap" aria-label="Stories">
    <SectionHead index={idx()} title="Stories" link={{ label: 'All stories', path: '/stories/' }} />
    <div class="grid grid--3">
      {stories.map((s) => <StoryCard story={s} />)}
    </div>
  </section>

  {
    crossVideos.length > 0 && (
      <section class="wrap cross" aria-label="Off the snow">
        <div class="cross-inner">
          <div class="cross-copy">
            <span class="mono">Off the snow</span>
            <h2>Skate &amp; BMX</h2>
            <p>Rainy days and shoulder seasons, the crew's at the skatepark.</p>
            <a href={href('/videos/?d=cross')} class="mono">All crossover clips →</a>
          </div>
          <div class="cross-cards">
            {crossVideos.slice(0, 2).map((v) => (
              <VideoCard video={v} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section wrap split" aria-label="Sessions and dictionary">
    <div>
      <SectionHead index={idx()} title="Upcoming sessions" link={{ label: 'All sessions', path: '/sessions/' }} />
      <div class="tickets">
        {
          rendered.length ? (
            rendered.map(({ e, Content }) => (
              <EventTicket event={e}>
                <Content />
              </EventTicket>
            ))
          ) : (
            <p class="empty">
              <strong>Nothing on the calendar yet</strong>
              Sessions get announced in the Facebook group first.
            </p>
          )
        }
      </div>
    </div>
    <aside class="word">
      <span class="mono">Park Dictionary · Word of the day</span>
      <h3 class="term">{word.term}</h3>
      <p>{word.definition}</p>
      <a href={href('/dictionary/')} class="mono">Browse the dictionary →</a>
    </aside>
  </section>

  <section class="wrap">
    <div class="cta-band">
      <div>
        <h2>Got a clip?</h2>
        <p>
          Landed your first rail, your first drop, or something huge? Post it in the group. If we'd like to feature it
          here, we'll ask first and credit you properly.
        </p>
      </div>
      <div class="cta-actions">
        {group && <a href={group} class="btn btn--hot" target="_blank" rel="noopener">Join the group ↗</a>}
        <a href={href('/share/')} class={group ? 'btn' : 'btn btn--hot'}>How featuring works</a>
        {insta && <a href={insta} class="btn" target="_blank" rel="noopener">Instagram ↗</a>}
      </div>
    </div>
  </section>
</Base>

<style>
  /* Bluebird hero: bright sky and ridgelines to match the Facebook group cover,
     fading into the dark site where the media lives. */
  .hero {
    position: relative;
    min-height: min(86vh, 800px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    isolation: isolate;
    background: #7fb8ec;
    color: #0b1320;
  }
  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    z-index: -2;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0.18) 45%, transparent 70%),
      linear-gradient(180deg, transparent 55%, rgba(10, 13, 18, 0.35) 82%, var(--bg) 100%);
  }
  .hero :global(canvas.snow) {
    opacity: 0.9;
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    padding-block: 96px 64px;
  }
  .eyebrow {
    color: #0b1320;
    font-weight: 700;
    margin-bottom: 18px;
  }
  .hero h1 {
    font-size: clamp(3.4rem, 13vw, 10rem);
    line-height: 0.86;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    color: #0b1320;
  }
  /* "Share it." sits on an ink sign plate so orange stays legible on the sky. */
  .hero h1 .hot {
    background: #0b1320;
    color: var(--orange);
    padding: 0.06em 0.16em 0.02em;
    margin-top: 0.08em;
    border-radius: 0.08em;
  }
  .lede {
    max-width: 50ch;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    font-weight: 500;
    color: #0b1320;
    margin-top: 26px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .btn--ink {
    border-color: #0b1320;
    color: #0b1320;
    background: rgba(255, 255, 255, 0.6);
  }
  .btn--ink:hover {
    background: #0b1320;
    color: #fff;
  }
  .season-chip {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 26px 0 0;
    padding: 6px 16px 6px 6px;
    border-radius: 999px;
    background: rgba(10, 13, 18, 0.82);
    color: var(--text);
    font-size: 0.92rem;
    max-width: 100%;
  }
  .pill {
    padding: 4px 10px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.66rem;
  }
  .pill--snow {
    background: var(--orange);
    color: var(--orange-ink);
  }
  .pill--bike {
    background: var(--moss);
    color: var(--moss-ink);
  }
  .pill--mud,
  .pill--stick {
    background: #6b5a4b;
    color: #f4e7da;
  }
  @media (max-width: 600px) {
    .season-chip {
      border-radius: var(--radius-sm);
    }
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 28px;
  }
  .tabs a {
    padding: 0.6em 1.1em;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg-2);
    color: var(--text);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
  }
  .tabs a:hover {
    border-color: var(--orange);
    color: var(--text);
  }
  .tabs a.on {
    background: var(--orange);
    border-color: var(--orange);
    color: var(--orange-ink);
  }
  .tabs .tab-mtb:hover {
    border-color: var(--moss);
  }
  .tabs .tab-cross:hover {
    border-color: var(--concrete);
  }
  .first {
    padding-top: 40px;
  }

  .summer {
    background:
      radial-gradient(900px 260px at 0% 0%, rgba(143, 184, 115, 0.16), transparent 70%),
      var(--bg);
    border-block: 1px solid color-mix(in srgb, var(--moss) 30%, var(--line));
  }
  .summer :global(.shead) {
    border-bottom-color: var(--moss);
  }
  .summer :global(.shead .idx) {
    color: var(--moss);
  }
  .band-intro {
    color: var(--muted);
    margin: -12px 0 24px;
  }

  .cross {
    padding-block: 8px clamp(40px, 6vw, 72px);
  }
  .cross-inner {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) 2fr;
    gap: clamp(20px, 3vw, 36px);
    align-items: center;
    padding: clamp(20px, 3vw, 28px);
    border: 1px dashed color-mix(in srgb, var(--concrete) 40%, transparent);
    border-radius: var(--radius);
  }
  @media (max-width: 800px) {
    .cross-inner {
      grid-template-columns: 1fr;
    }
  }
  .cross-copy .mono {
    color: var(--concrete);
  }
  .cross-copy h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.4rem);
    margin: 8px 0 10px;
  }
  .cross-copy p {
    color: var(--muted);
    margin-bottom: 10px;
  }
  .cross-copy a {
    color: var(--concrete);
  }
  .cross-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 16px;
  }

  .ticker {
    position: relative;
    z-index: 2;
    border-block: 1px solid var(--line);
    background: var(--orange);
    color: var(--orange-ink);
    overflow: hidden;
    white-space: nowrap;
  }
  .track {
    display: inline-flex;
    animation: marquee 40s linear infinite;
    padding-block: 10px;
  }
  .track span {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.25rem;
    letter-spacing: 0.04em;
    padding-inline: 18px;
    display: inline-flex;
    align-items: center;
    gap: 36px;
  }
  .track i {
    font-style: normal;
    font-size: 0.6rem;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .vid-grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: clamp(16px, 2.4vw, 28px);
  }
  .vid-side {
    display: grid;
    gap: clamp(16px, 2.4vw, 28px);
    align-content: start;
  }
  @media (max-width: 900px) {
    .vid-grid {
      grid-template-columns: 1fr;
    }
    .vid-side {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    }
  }

  .photo-band {
    background: var(--bg-2);
    border-block: 1px solid var(--line);
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(10px, 1.6vw, 18px);
    align-items: start;
  }
  @media (max-width: 800px) {
    .strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .strip :global(.tile) {
    margin: 0;
  }
  /* Uniform 4:5 crops so portrait and landscape shots sit in one even row. */
  .strip :global(.tile img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .split {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
  .tickets {
    display: grid;
    gap: 16px;
  }
  .word {
    background: var(--snow);
    color: var(--orange-ink);
    border-radius: var(--radius);
    padding: 28px;
    position: sticky;
    top: calc(var(--header-h) + 24px);
    box-shadow: 8px 8px 0 var(--orange);
  }
  .word .mono {
    color: #7a3a1a;
  }
  .word .term {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 14px 0 12px;
  }
  .word a {
    color: var(--orange-ink);
    font-weight: 700;
  }

  .cta-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(28px, 5vw, 56px);
    border-radius: calc(var(--radius) * 1.5);
    background:
      radial-gradient(600px 240px at 100% 0%, rgba(143, 211, 255, 0.25), transparent 70%),
      linear-gradient(135deg, #ff5a1f, #ff7e3f);
    color: var(--orange-ink);
  }
  .cta-band h2 {
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    margin-bottom: 12px;
  }
  .cta-band p {
    max-width: 52ch;
    margin: 0;
    font-weight: 500;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .cta-band .btn {
    border-color: var(--orange-ink);
    color: var(--orange-ink);
  }
  .cta-band .btn:hover {
    background: var(--orange-ink);
    color: var(--snow);
  }
  .cta-band .btn--hot {
    background: var(--orange-ink);
    color: var(--snow);
  }
  .cta-band .btn--hot:hover {
    background: var(--snow);
    color: var(--orange-ink);
    border-color: var(--snow);
  }
</style>
